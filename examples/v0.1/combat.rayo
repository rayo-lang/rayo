// A goblin and a troll fight, round by round, until one of them falls.
//
// Before the fight, the goblin sizes the troll up. Each round prints its number, then each hit as the change it
// makes to its target's health, and the health left. The troll's armor turns most of the goblin's hits into
// scratches, and the troll rests on every fourth round and regenerates; but the goblin, once its health falls below
// half, is enraged, and its fury cracks that armor. After the fight, the program prints who still stands.

func main() {
    var goblin = Enemy(stats: Stats(hp: 44, maxHp: 44, armor: 4), strength: 7, enraged: false)
    var troll = Enemy(stats: Stats(hp: 44, maxHp: 44, armor: 8), strength: 4, enraged: false)

    // The goblin sizes the troll up on copies, which leave the troll unchanged: its first blow, the health that
    // blow leaves, how many such blows the troll can take, and what the blow would be against no armor.
    let blow = hit(from: goblin, on: troll, in: 1)
    print(blow)
    var left = copy troll.stats.hp
    left -= blow
    print(left)
    print(troll.stats.hp)
    print(hitsToFell(troll.stats.hp, by: blow))
    var bare = copy troll
    bare.stats.armor = 0
    print(hit(from: goblin, on: bare, in: 1))
    print(troll.stats.armor)

    // The fight goes on while the goblin stands, and ends early once the troll falls.
    var round = 0
    var fatigue = 0
    while goblin.stats.hp > 0 {
        round += 1
        print(round)

        // The troll tires over three rounds, and on the fourth, if it is hurt, rests: it gives up its worn stats
        // for healed ones, and neither enemy hits.
        fatigue += 1
        fatigue %= 4
        if fatigue == 0 && troll.stats.hp != troll.stats.maxHp {
            let worn = troll.stats
            troll.stats = Stats(hp: worn.hp + 5, maxHp: worn.maxHp, armor: worn.armor)
            print(troll.stats.hp)
            continue
        }

        // The goblin hits first, and a troll it fells ends the fight without hitting back.
        let byGoblin = hit(from: goblin, on: troll, in: round)
        print(-byGoblin)
        troll.stats.hp -= byGoblin
        print(troll.stats.hp)
        if troll.stats.hp <= 0 { break }

        let byTroll = hit(from: troll, on: goblin, in: round)
        print(-byTroll)
        goblin.stats.hp -= byTroll
        print(goblin.stats.hp)

        // The goblin is enraged once its health falls below half, and its fury cracks the troll's armor.
        if !goblin.enraged && goblin.stats.hp * 2 < goblin.stats.maxHp {
            goblin.enraged = true
            troll.stats.armor /= 2
            print(goblin.enraged)
        }
    }

    // Whether each enemy stands, the health of the one that does, and the goblin's boast of a fight twice as long.
    let goblinStands = goblin.stats.hp > 0
    print(goblinStands)
    print(troll.stats.hp > 0)
    if goblinStands { print(goblin.stats.hp) } else { print(troll.stats.hp) }
    var boast = copy round
    boast *= 2
    print(boast)
    print(round)
}

// The damage `attacker`'s hit in `round` deals to `defender`.
func hit(from attacker: Enemy, on defender: Enemy, in round: Int) -> Int {
    // The hit lands twice as hard on every third round, and on every round once the attacker is enraged.
    var damage = copy attacker.strength
    if round % 3 == 0 || attacker.enraged { damage *= 2 }

    // Armor at least as strong as the hit leaves it a scratch, and weaker armor takes off half its own strength.
    if defender.stats.armor >= damage { damage = 1 } else { damage -= defender.stats.armor / 2 }
    return damage
}

// How many hits of `damage` it takes to bring `hp` to 0 or below.
func hitsToFell(_ hp: Int, by damage: Int) -> Int {
    if hp <= 0 { return 0 }
    return 1 + hitsToFell(hp - damage, by: damage)
}

struct Enemy(var stats: Stats, let strength: Int, var enraged: Bool)
struct Stats(var hp: Int, let maxHp: Int, var armor: Int)
