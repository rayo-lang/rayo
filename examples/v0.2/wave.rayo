// Two heroes in turn fight the same two waves of enemies, the second wave coming on once the first has fallen. Each
// round the hero strikes the enemy with the most health, and the blow cleaves into the enemies beside it. Then each
// enemy still standing strikes the hero.
//
// Each round prints its number, the health the blow leaves its target and then each enemy beside it, and the hero's
// health once the wave has struck. After each fight the program prints the round each wave fell in, or 0 for a wave
// still standing when the hero fell.

func main() {
    // The first wave is a line of shield-bearers, all alike, and the second three different fighters.
    let waves: [2 of [3 of Enemy]] = [
        .init(repeating: Enemy(hp: 16, armor: 6, attack: 2)),
        [Enemy(hp: 20, armor: 2, attack: 4), Enemy(hp: 30, armor: 4, attack: 6), Enemy(hp: 16, armor: 0, attack: 3)],
    ]

    // The swordsman's blows are steady, and the axeman's come as one heavy blow and two light ones.
    let swordsman = Hero(hp: 44, combo: [16, 10, 22])
    let axeman = Hero(hp: 44, combo: [30, 6, 6])
    let bySwordsman = fight(swordsman, against: waves)
    report(bySwordsman)
    let byAxeman = fight(axeman, against: waves)
    report(byAxeman)
}

// Fights `hero` against each of `waves` in turn, and gives the round each wave fell in, or 0 for a wave still
// standing when the hero fell.
func fight(_ hero: &Hero, against waves: &[2 of [3 of Enemy]]) -> [2 of UInt] {
    // The fight changes copies of the hero's health and of each wave, so the next hero meets the same waves.
    var hp = hero.hp

    ref let combo = &hero.combo
    let sides: [2 of Int] = [-1, 1]
    var fellIn: [2 of UInt] = .init(repeating: 0)
    var round: UInt = 0
    var wave: UInt = 0
    while hp > 0 && wave < waves.count {
        var enemies = copy waves[wave]
        while hp > 0 {
            // A wave has fallen once its strongest enemy has.
            let target = strongest(in: enemies)
            if enemies[target].hp <= 0 {
                fellIn[wave] = round
                break
            }
            round += 1
            print(round)

            // The hero's blows follow its combo, which starts over once it runs out.
            let blow = combo[(round - 1) % combo.count]
            enemies[target].hp -= damage(from: blow, on: enemies[target])
            print(enemies[target].hp)

            // The blow cleaves into each standing enemy beside the target for half as much. A target at either end
            // of the wave has no enemy on that side.
            var side: UInt = 0
            while side < sides.count {
                let beside = Int(target) + sides[side]
                if beside >= 0 && beside < Int(enemies.count) {
                    let enemy = UInt(beside)
                    if enemies[enemy].hp > 0 {
                        enemies[enemy].hp -= damage(from: blow / 2, on: enemies[enemy])
                        print(enemies[enemy].hp)
                    }
                }
                side += 1
            }

            // Each enemy still standing strikes the hero back.
            var enemy: UInt = 0
            while enemy < enemies.count {
                ref let foe = &enemies[enemy]
                if foe.hp > 0 { hp -= foe.attack }
                enemy += 1
            }
            print(hp)
        }
        wave += 1
    }
    return consume fellIn
}

// Prints the round each wave fell in.
func report(_ fellIn: &[2 of UInt]) {
    var wave: UInt = 0
    while wave < fellIn.count {
        print(fellIn[wave])
        wave += 1
    }
}

// Gives the damage a blow of `strength` deals `enemy`: armor at least as strong as the blow leaves it a scratch, and
// weaker armor takes its own strength off the blow.
func damage(from strength: Int, on enemy: &Enemy) -> Int {
    if enemy.armor >= strength { return 1 }
    return strength - enemy.armor
}

// Gives the index of the enemy with the most health, the first of them on a tie.
func strongest(in enemies: &[3 of Enemy]) -> UInt {
    var strongest: UInt = 0
    var enemy: UInt = 1
    while enemy < enemies.count {
        if enemies[enemy].hp > enemies[strongest].hp { strongest = enemy }
        enemy += 1
    }
    return strongest
}

struct Hero(let hp: Int, let combo: [3 of Int])
struct Enemy(var hp: Int, let armor: Int, let attack: Int)
